{
  "provider": {
    "name": "custom",
    "kind": "openai",
    "base_url": "https://router.kiosapi.com/v1",
    "api_key_env": "VAGENT_API_KEY",
    "model": "oc/muse-spark-1.3-contributor",
    "context_limit": 128000,
    "streaming": true,
    "temperature": 0.0,
    "max_tokens": 8192,
    "timeout_secs": 300,
    "headers": {},
    "input_price": 0.0,
    "output_price": 0.0
  },
  "agent": {
    "max_iterations": 30,
    "max_tool_retries": 2,
    "max_tool_output": 30000,
    "shell_timeout_secs": 120,
    "system_prompt_extra": ""
  },
  "permissions": {
    "mode": "ask",
    "auto_approve_read": true,
    "confine_to_root": true,
    "allow": [
      "git status",
      "git diff",
      "ls",
      "search_text",
      "search_files"
    ],
    "deny": [
      "rm -rf /",
      "mkfs",
      "*git push*",
      "*curl*|*sh*"
    ]
  },
  "ui": {
    "color": true,
    "unicode": true,
    "show_tokens": true,
    "show_plan": true,
    "stream": true,
    "compact": false
  },
  "log": {
    "level": "info",
    "to_stderr": false
  }
}
